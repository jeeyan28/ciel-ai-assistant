# Configuration reference for the Ciel system design.
# The frontend demo does not read these variables or require an environment file.
# Replace placeholder credentials only in an ignored local .env file.

# Authentication: the specification requires distinct tokens of 32+ characters.
CIEL_TOKEN=<YOUR_CIEL_TOKEN>
# An empty device token disables the specified device-scoped routes.
DEVICE_TOKEN=

# Model provider: groq, gemini, or ollama; select a provider-supported model ID.
CIEL_LLM_PROVIDER=groq
CIEL_LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Local embedding model and relative-date timezone in the architecture.
CIEL_EMBEDDING_MODEL=nomic-embed-text-v1.5
CIEL_TIMEZONE=Asia/Manila

# Isolated fictional-data replay policy defined by the system specification.
CIEL_DEMO_MODE=false

# Database values for the reference deployment layout.
# Its DATABASE_URL interpolation requires URI-safe credential values.
POSTGRES_USER=ciel
POSTGRES_PASSWORD=<YOUR_DATABASE_PASSWORD>
POSTGRES_DB=ciel
# Optional connection string for the specified API outside the reference layout:
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>

# Search and read-only mailbox integration configuration in the specification.
SEARCH_API_KEY=
CIEL_ENCRYPTION_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Poll interval in seconds (specified range: 15–3600).
CIEL_EMAIL_POLL_INTERVAL=60
# Per-automation execution cap; excess triggers are skipped and audited.
CIEL_AUTOMATION_MAX_RUNS_PER_HOUR=10
